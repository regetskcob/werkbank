# shellcheck shell=bash disable=SC2034
# Settings for tool/werkbank (bash, sourced). Everything is optional.
# See STANDARD.md in tool/werkbank/, "werkbank.conf".

# Name used for release files (build/release/<app>-<version>.aab) and the
# symbols folder; default: name in pubspec.yaml.
#WB_APP=my-app

# Additional top-level entries and media folders (extended regular
# expressions, joined with |), for what only this project has.
#WB_TOP_EXTRA='ha-addon|box'
#WB_MEDIA_EXTRA='box/case/'

# Paths for dart format, extra arguments for flutter analyze and flutter test.
#WB_FORMAT_PATHS='lib test'   # default: lib test integration_test test_driver, as far as present
#WB_ANALYZE_ARGS=''
#WB_TEST_ARGS='--exclude-tags golden'

# Hugo sites checked by werkbank verify (default: site if site/hugo.toml exists).
#WB_SITE_DIRS='site teaser'

# Where debug symbols of release builds are kept (default ~/keys/symbols/<app>).
#WB_SYMBOLS_DIR=~/keys/symbols/my-app

# Extra arguments for the release builds (printed, split at spaces).
#android_args() { echo --obfuscate --split-debug-info=build/symbols/android; }
#ios_args() { echo --obfuscate --split-debug-info=build/symbols/ios; }

# Further checks after the tests that the CI runs too (also with --quick).
#verify_quick_extra() {
#  say "Parser tests"
#  node --test supabase/tests/
#}

# Further slow checks after the tests (not with --quick).
#verify_extra() {
#  say "Web build"
#  flutter build web --release --no-pub >/dev/null
#}

# Store texts and uploads (STANDARD.md "Release-Texte"): tag prefix of app
# releases (drafts list what was merged since), store languages, Play.
#WB_APP_TAG_PREFIX='app-v'
#WB_STORE_LANGS='de-DE en-US'
#WB_PLAY_PACKAGE='de.example.app'
#WB_PLAY_KEY=~/keys/my-app-play.json   # default ~/keys/<app>-play.json
#WB_PLAY_TRACK='alpha'                  # internal (default), alpha = closed test, beta, production
#WB_PLAY_STATUS='draft'                 # completed (default); draft while the app is not published yet

# Device tests: which integration tests (default all integration_test/*_test.dart),
# and what to do around each device (back up app data, quit the app).
#WB_DEVICETEST_TARGETS='integration_test/session_test.dart'
#devicetest_before() { :; }  # $1 device id, $2 ios|android|macos
#devicetest_after() { :; }

# Release (STANDARD.md "Release"): products, their version files, tag prefixes and
# platforms; GitHub releases; sites and which of them a release deploys.
#WB_PRODUCTS='app addon'
#WB_VERSION_FILE_addon=addon/config.yaml
#WB_TAG_PREFIX_addon='addon-v'
#WB_PLATFORMS_app='ios android macos'
#WB_GH_RELEASE_REPO='owner/repo'
#WB_SITES='site=site|https://www.regetskcob.de/app/|blog:app teaser=teaser|https://app.de/|ghpages:owner/repo:app.de'
#WB_RELEASE_SITES='site'
#release_addon() { :; }      # $1 true with --upload; builds the product itself
#build_macos() { :; }        # a platform werkbank does not build
#release_manual() { echo "- release the Play draft in the console"; }
